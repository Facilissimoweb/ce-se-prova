{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/news/primo-settenario-mappa-identita",
      "destination": "/news/il-coraggio-di-iniziare-il-matto",
      "permanent": true
    },
    {
      "source": "/blog/primo-settenario-mappa-identita",
      "destination": "/news/il-coraggio-di-iniziare-il-matto",
      "permanent": true
    },
    {
      "source": "/articoli/primo-settenario-mappa-identita",
      "destination": "/news/il-coraggio-di-iniziare-il-matto",
      "permanent": true
    },
    {
      "source": "/news/Giustizia%20Articolo",
      "destination": "/news/la-giustizia-equilibrio-e-numerazione",
      "permanent": true
    },
    {
      "source": "/news/Giustizia Articolo",
      "destination": "/news/la-giustizia-equilibrio-e-numerazione",
      "permanent": true
    },
    {
      "source": "/news/giustizia-articolo",
      "destination": "/news/la-giustizia-equilibrio-e-numerazione",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://gen-lang-client-0853491667.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://gen-lang-client-0853491667.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/news",
      "destination": "/api/news"
    },
    {
      "source": "/api/courses",
      "destination": "/api/courses"
    },
    {
      "source": "/api/bookings",
      "destination": "/api/bookings"
    },
    {
      "source": "/api/bookings/availability",
      "destination": "/api/booking-availability"
    },
    {
      "source": "/api/bookings/(.*)",
      "destination": "/api/bookings?__path=$1"
    },
    {
      "source": "/api/stripe/(.*)",
      "destination": "/api/stripe?__path=$1"
    },
    {
      "source": "/api/reserved/(.*)",
      "destination": "/api/reserved?__path=$1"
    },
    {
      "source": "/api/dialogue/(.*)",
      "destination": "/api/dialogue?__path=$1"
    },
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/coming-soon",
      "destination": "/api/coming-soon"
    },
    {
      "source": "/api/coming-soon/(.*)",
      "destination": "/api/coming-soon?__path=$1"
    },
    {
      "source": "/((?!api(?:/|$)|__(?:/|$)|\\.well-known(?:/|$)|privacy\\.html|coming-soon\\.html|sitemap\\.xml|robots\\.txt|llms\\.txt|llms-full\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
