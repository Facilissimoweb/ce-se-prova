{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/news/primo-settenario-mappa-identita",
      "destination": "/news/il-coraggio-di-iniziare-il-matto",
      "permanent": true
    },
    {
      "source": "/blog/primo-settenario-mappa-identita",
      "destination": "/news/il-coraggio-di-iniziare-il-matto",
      "permanent": true
    },
    {
      "source": "/articoli/primo-settenario-mappa-identita",
      "destination": "/news/il-coraggio-di-iniziare-il-matto",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://gen-lang-client-0853491667.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://gen-lang-client-0853491667.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/news",
      "destination": "/api/news"
    },
    {
      "source": "/api/courses",
      "destination": "/api/courses"
    },
    {
      "source": "/api/bookings",
      "destination": "/api/bookings"
    },
    {
      "source": "/api/bookings/availability",
      "destination": "/api/booking-availability"
    },
    {
      "source": "/api/bookings/(.*)",
      "destination": "/api/bookings?__path=$1"
    },
    {
      "source": "/api/stripe/(.*)",
      "destination": "/api/stripe?__path=$1"
    },
    {
      "source": "/api/reserved/(.*)",
      "destination": "/api/reserved?__path=$1"
    },
    {
      "source": "/api/dialogue/(.*)",
      "destination": "/api/dialogue?__path=$1"
    },
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/coming-soon",
      "destination": "/api/coming-soon"
    },
    {
      "source": "/api/coming-soon/(.*)",
      "destination": "/api/coming-soon?__path=$1"
    },
    {
      "source": "/((?!api(?:/|$)|__(?:/|$)|\\.well-known(?:/|$)|privacy\\.html|coming-soon\\.html|sitemap\\.xml|robots\\.txt|llms\\.txt|llms-full\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
