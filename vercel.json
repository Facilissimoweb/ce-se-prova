{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/news",
      "destination": "/api/news"
    },
    {
      "source": "/api/courses",
      "destination": "/api/courses"
    },
    {
      "source": "/api/bookings",
      "destination": "/api/bookings"
    },
    {
      "source": "/api/bookings/(.*)",
      "destination": "/api/bookings?__path=$1"
    },
    {
      "source": "/api/stripe/(.*)",
      "destination": "/api/stripe?__path=$1"
    },
    {
      "source": "/api/reserved/(.*)",
      "destination": "/api/reserved?__path=$1"
    },
    {
      "source": "/api/dialogue/(.*)",
      "destination": "/api/dialogue?__path=$1"
    },
    {
      "source": "/((?!api(?:/|$)|privacy\\.html|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
