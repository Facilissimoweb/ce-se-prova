# APP_URL: URL pubblico dell'app (OAuth callback, success_url Stripe, link interni).
# Su Vercel: https://www.tarotitalia.com (dopo cutover) oppure l'URL *.vercel.app di preview.
# In AI Studio / Cloud Run può essere iniettato automaticamente.
APP_URL="MY_APP_URL"

# --- Postgres ---
# Preferito su Vercel: connection string TCP (Neon, Cloud SQL public IP, altro host gestito).
# Il socket Unix Cloud SQL (`/cloudsql/...`) NON funziona su Vercel.
DATABASE_URL=""
# In alternativa (host Node / Cloud Run / AI Studio):
SQL_HOST="/cloudsql/PROJECT:REGION:INSTANCE"
SQL_DB_NAME="app_db"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"
# SSL verso Postgres gestito (default on se usi DATABASE_URL). Metti "false" solo in locale.
SQL_SSL=""
# Pool size (default 1 su Vercel, 10 altrove)
SQL_POOL_MAX=""

# Firebase Admin (obbligatorio su Vercel per verificare ID token).
# JSON service account in UNA riga — solo in Vercel Project Settings → Environment Variables, mai in chat.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Stripe Checkout (obbligatorio in produzione per corsi, dialogo, consulti)
# Valori reali solo in secret store / Vercel Env — non in chat.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Price ID opzionali (Dashboard → Products). Se assenti, Checkout usa price_data EUR.
STRIPE_PRICE_ID_DIALOGO_5M=""
STRIPE_PRICE_ID_DIALOGO_10M=""
STRIPE_PRICE_ID_DIALOGO_15M=""
STRIPE_PRICE_ID_CORSO_ARCANI_MAGGIORI=""
STRIPE_PRICE_ID_CORSO_ARCANI_MINORI=""
STRIPE_PRICE_ID_CORSO_METODI_STESURA=""
STRIPE_PRICE_ID_CONSULTO_20M=""
STRIPE_PRICE_ID_CONSULTO_45M=""
STRIPE_PRICE_ID_CONSULTO_60M=""
STRIPE_PRICE_ID_CONSULTO_90M=""

# Solo sviluppo / preview locale: sblocchi senza Stripe.
# Ignorato quando NODE_ENV=production (anche su Vercel Production).
ALLOW_DIRECT_UNLOCK="false"

# --- Zoho Mail (conferme prenotazione + mail studio) ---
# Usa una App Password Zoho, non la password di login.
ZOHO_EMAIL=""
ZOHO_PASSWORD=""
ZOHO_SMTP_HOST="smtp.zoho.eu"
ZOHO_SMTP_PORT="465"
# Opzionali (default: ZOHO_EMAIL / "Maria Teresa Rogani · Tarot Italia")
ZOHO_FROM_EMAIL=""
ZOHO_FROM_NAME=""
ZOHO_STUDIO_EMAIL=""

# --- Google Calendar (evento opaco dopo pagamento + FreeBusy disponibilità) ---
# Preferire OAuth sul Gmail personale del calendario agenda.
GOOGLE_CALENDAR_ID=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_CALENDAR_REFRESH_TOKEN=""
# Alias accettato:
# GOOGLE_OAUTH_REFRESH_TOKEN=""
# Alternativa service account (calendario condiviso con GOOGLE_CLIENT_EMAIL):
# GOOGLE_CLIENT_EMAIL=""
# GOOGLE_PRIVATE_KEY=""

# Link assistenza WhatsApp nelle email di conferma (opzionale)
WHATSAPP_ASSIST_URL="https://wa.me/393791038253"

# --- Google Maps Embed (pagina Contatti, opzionale) ---
# Non obbligatorio: senza key la pagina usa iframe Maps legacy (output=embed).
# Se presente, Contatti usa Embed API ufficiale (place + search parcheggi).
# Da impostare in Vercel Env / Cloud Agents ENV (lunedì) se si vuole l’embed ufficiale.
# VITE_GOOGLE_MAPS_API_KEY=""
