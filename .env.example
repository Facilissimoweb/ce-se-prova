# APP_URL: URL pubblico dell'app (OAuth callback, success_url Stripe, link interni).
# In AI Studio viene iniettato automaticamente (es. Cloud Run).
APP_URL="MY_APP_URL"

# Cloud SQL for PostgreSQL (iniettato in AI Studio / host gestito)
SQL_HOST="/cloudsql/PROJECT:REGION:INSTANCE"
SQL_DB_NAME="app_db"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"

# Stripe Checkout (opzionale; senza chiave reale il dialogo usa fallback preview)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_DIALOGO_5M=""
STRIPE_PRICE_ID_DIALOGO_10M=""
STRIPE_PRICE_ID_DIALOGO_15M=""
