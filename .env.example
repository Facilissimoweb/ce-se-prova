# APP_URL: URL pubblico dell'app (OAuth callback, success_url Stripe, link interni).
# Vercel Production: https://tarotitalia.com (o https://www.tarotitalia.com se è il canonical scelto).
# Preview: può restare l'URL *.vercel.app della preview — MAI usarlo come Production APP_URL.
# In AI Studio / Cloud Run può essere iniettato automaticamente.
APP_URL="https://tarotitalia.com"

# SEO / sitemap (ENN-62 / ENN-198): origine assoluta per canonical, Open Graph e sitemap.xml a build.
# Vercel → Project → Environment Variables → Production (poi Redeploy):
#   APP_URL=https://tarotitalia.com
#   VITE_SITE_ORIGIN=https://tarotitalia.com
# Non impostare Production su ce-se-prova.vercel.app / *.vercel.app: il build sitemap
# ignora quei host e defaulta a https://tarotitalia.com (VERCEL_PROJECT_PRODUCTION_URL
# è il hostname di progetto Vercel, non il dominio custom).
# VITE_SITE_ORIGIN="https://tarotitalia.com"

# --- Postgres ---
# Preferito su Vercel + Supabase: Transaction pooler (IPv4), NON Direct (db.*.supabase.co).
# Forma: postgresql://postgres.<PROJECT>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Verifica: host contiene "pooler.supabase.com", porta 6543, query pgbouncer=true.
# Il socket Unix Cloud SQL (`/cloudsql/...`) NON funziona su Vercel.
DATABASE_URL=""
# In alternativa (host Node / Cloud Run / AI Studio):
SQL_HOST="/cloudsql/PROJECT:REGION:INSTANCE"
SQL_DB_NAME="app_db"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"
# SSL verso Postgres gestito (default on se usi DATABASE_URL). Metti "false" solo in locale.
SQL_SSL=""
# Pool size (default 1 su Vercel, 10 altrove)
SQL_POOL_MAX=""
# Override timeout acquire (ms). Default: 10000 su Vercel, 15000 altrove.
SQL_CONNECTION_TIMEOUT_MS=""
# Override idle client release (ms). Default: 5000 su Vercel, 10000 altrove.
SQL_IDLE_TIMEOUT_MS=""

# Firebase Admin (obbligatorio su Vercel per verificare ID token).
# JSON service account in UNA riga — solo in Vercel Project Settings → Environment Variables, mai in chat.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Stripe Checkout (obbligatorio in produzione per corsi, dialogo, consulti)
# Valori reali solo in secret store / Vercel Env — non in chat.
# Deve essere Secret key sk_live_… / sk_test_… (o rk_…), MAI Publishable pk_….
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Price ID opzionali (Dashboard → Products). Se assenti, Checkout usa price_data EUR.
STRIPE_PRICE_ID_DIALOGO_5M=""
STRIPE_PRICE_ID_DIALOGO_10M=""
STRIPE_PRICE_ID_DIALOGO_15M=""
STRIPE_PRICE_ID_CORSO_ARCANI_MAGGIORI=""
STRIPE_PRICE_ID_CORSO_ARCANI_MINORI=""
STRIPE_PRICE_ID_CORSO_METODI_STESURA=""
STRIPE_PRICE_ID_CONSULTO_20M=""
STRIPE_PRICE_ID_CONSULTO_45M=""
STRIPE_PRICE_ID_CONSULTO_60M=""
STRIPE_PRICE_ID_CONSULTO_90M=""

# Solo sviluppo / preview locale: sblocchi senza Stripe.
# Ignorato quando NODE_ENV=production (anche su Vercel Production).
ALLOW_DIRECT_UNLOCK="false"

# --- Zoho Mail (conferme prenotazione + mail studio) ---
# Usa una App Password Zoho, non la password di login.
ZOHO_EMAIL=""
ZOHO_PASSWORD=""
ZOHO_SMTP_HOST="smtp.zoho.eu"
ZOHO_SMTP_PORT="465"
# Opzionali (default: ZOHO_EMAIL / "Maria Teresa Rogani · Tarot Italia")
ZOHO_FROM_EMAIL=""
ZOHO_FROM_NAME=""
ZOHO_STUDIO_EMAIL=""

# --- Google Calendar (evento opaco dopo pagamento + FreeBusy disponibilità) ---
# Preferire OAuth sul Gmail personale del calendario agenda.
GOOGLE_CALENDAR_ID=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_CALENDAR_REFRESH_TOKEN=""
# Alias accettato:
# GOOGLE_OAUTH_REFRESH_TOKEN=""
# Alternativa service account (calendario condiviso con GOOGLE_CLIENT_EMAIL):
# GOOGLE_CLIENT_EMAIL=""
# GOOGLE_PRIVATE_KEY=""

# Link assistenza WhatsApp nelle email di conferma (opzionale)
WHATSAPP_ASSIST_URL="https://wa.me/393791038253"
# Specchio client (prenotazione consulti → messaggio WhatsApp). Se assente: wa.me default.
# VITE_WHATSAPP_ASSIST_URL="https://wa.me/393791038253"

# --- Google Maps (pagina Contatti, opzionale ma consigliato per stile dark/oro) ---
# Non obbligatorio: senza key Contatti usa iframe Maps soft (filtro CSS + CTA “Apri su Maps”).
# Con key: Maps JavaScript API + stili JSON dark/oro (pan/zoom). Abilitare in Google Cloud:
#   - Maps JavaScript API (necessaria per lo stile brand)
#   - Maps Embed API (solo fallback se JS fallisce)
# Restringere la key per HTTP referrer (tarotitalia.com / *.vercel.app).
# Vercel → Project → Environment Variables → Production (+ Preview se vuoi) → Redeploy.
# VITE_GOOGLE_MAPS_API_KEY=""

# --- Chat generica FAB (Groq, server-side only) ---
# Nome Vercel ESATTO. Mai VITE_*: la chiave resta solo sul server (`/api/chat`).
# Senza questa variabile il FAB resta sui contatti (WhatsApp / Telegram / email).
# Non chiedere né loggare il valore del secret.
TAROTITALIACHATGENERICAGROQ_API_KEY=""
# Opzionale: override modello (default openai/gpt-oss-20b — Groq ha ritirato llama-3.1-8b-instant)
# GROQ_CHAT_MODEL="openai/gpt-oss-20b"

# --- Coming Soon gate (ENN-92/94) — visitatori pubblici vs anteprima Maria ---
# Su Vercel Production: COMING_SOON_ENABLED=true + COMING_SOON_UNLOCK_TOKEN → Redeploy.
# Di default il gate vale solo per www.tarotitalia.com / tarotitalia.com.
# COMING_SOON_ALL_HOSTS=true attiva il gate anche su *.vercel.app / localhost (test).
# Sblocco owner (consigliato ENN-95): «Entra con Google» su Coming Soon se email in allowlist
# (default mariateresarogani@gmail.com). Opzionale: COMING_SOON_OWNER_EMAILS=a@x.com,b@y.com
# One-click link (opz.): /admin/com?t=<COMING_SOON_UNLOCK_TOKEN>
# Path built-in: /preview-atelier e /admin/com. Password = backup opzionale.
# COMING_SOON_SECRET_PATH deve essere un path URL (es. /preview-atelier), MAI una chiave Stripe.
# Mai VITE_*: token/password solo server / middleware.
COMING_SOON_ENABLED="false"
# COMING_SOON_OWNER_EMAILS=""
COMING_SOON_UNLOCK_TOKEN=""
# Backup password (opzionale):
COMING_SOON_PASSWORD=""
# Alternativa: SHA-256 hex della password (minuscolo). Se impostato, ha priorità sul plain.
# COMING_SOON_PASSWORD_HASH=""
# COMING_SOON_SECRET_PATH="/preview-atelier"
# COMING_SOON_ALL_HOSTS="false"
