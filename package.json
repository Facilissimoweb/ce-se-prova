{
  "name": "tarot-italia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "node scripts/build-blog.mjs && vite build && node scripts/bundle-api.mjs",
    "build:api": "node scripts/bundle-api.mjs",
    "build:nina-maggiori": "npx tsx scripts/build-nina-maggiori-cards.ts",
    "build:nina-minori": "npx tsx scripts/build-nina-minori-cards.ts",
    "build:nina-blog": "npm run build:blog && npx tsx scripts/build-nina-blog-pack.ts",
    "build:blog": "node scripts/build-blog.mjs",
    "test:nina-studio": "npx tsx scripts/assert-nina-studio-split.ts && npx tsx scripts/assert-nina-maggiori-source.ts && npx tsx scripts/assert-nina-minori-source.ts && npx tsx scripts/assert-nina-blog-source.ts && npx tsx scripts/assert-nina-studio-payload.ts",
    "test:nina-chat-gt": "npx tsx scripts/assert-nina-chat-gt.ts",
    "test:nina-it-bullets": "npx tsx scripts/assert-nina-it-bullets.ts && npx tsx scripts/assert-nina-gt-lang.ts",

    "test:gt-codes-ui": "npx tsx scripts/assert-gt-codes-ui.ts",
    "test:gt-freeze": "npx tsx scripts/assert-gt-freeze.ts",
    "test:booking-lang-notice": "npx tsx scripts/assert-booking-lang-notice.ts",
    "test:booking-step-scroll": "npx tsx scripts/assert-booking-step-scroll.ts",
    "seo:generate": "node scripts/generate-seo-assets.mjs",
    "test:sitemap-origin": "npx tsx scripts/assert-sitemap-canonical-origin.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js api/courses.js api/bookings.js api/booking-availability.js api/stripe.js api/reserved.js api/dialogue.js api/news.js api/chat.js api/coming-soon.js",
    "lint": "npm run build:blog && tsc --noEmit",
    "test:dialogue-domain": "npx tsx scripts/assert-dialogue-domain-distinct.ts",
    "test:dispensa-pdf-html": "npx tsx scripts/assert-dispensa-branded-html.ts",
    "test:maggiori-it-source": "npx tsx scripts/assert-maggiori-it-source.ts",
    "test:maggiori-purchase-hold": "npx tsx scripts/assert-maggiori-purchase-hold.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vercel/functions": "^3.11.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "firebase": "^13.3.0",
    "firebase-admin": "13.10.0",
    "i18next": "^27.2.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^18.0.3",
    "vite": "^8.3.0"
  },
  "overrides": {
    "jwks-rsa": "3.2.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
